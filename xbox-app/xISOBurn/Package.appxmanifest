<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  IgnorableNamespaces="uap mp">

  <!--
    Publisher must be identical to the Subject of the certificate that signs the package.
    The GitHub workflow generates a self-signed certificate with CN=xISOBurn.
    The version is rewritten by the workflow (0.1.<build number>.0).
  -->
  <Identity
    Name="xISOBurn"
    Publisher="CN=xISOBurn"
    Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="6e1b7c2a-4f3d-4b8e-9a51-2c7d8e0f1a3b" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>xISOBurn</DisplayName>
    <PublisherDisplayName>xISOBurn</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="xISOBurn.App">
      <!--
        Image paths have no scale qualifier: the resource system picks the
        .scale-100 / .scale-200 / .targetsize-* file that fits the screen.
        Black background to match the artwork.
      -->
      <uap:VisualElements
        DisplayName="xISOBurn"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        Description="Copies the disc in the Xbox drive to an ISO image on your PC"
        BackgroundColor="#000000">
        <!-- JPEG on black: as PNG the logo's glow exceeds the 200 KB limit per manifest image (APPX3207). -->
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.jpg"/>
        <uap:SplashScreen Image="Assets\SplashScreen.jpg" BackgroundColor="#000000"/>
      </uap:VisualElements>
      <!--
        On removable drives a UWP app only sees files of the types it declares here (removableStorage
        capability below): the copies' .iso/.map/.sha256 and the logs. Needed for USB storage.
      -->
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="xisoburnfiles">
            <uap:DisplayName>xISOBurn disc copy</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.iso</uap:FileType>
              <uap:FileType>.map</uap:FileType>
              <uap:FileType>.sha256</uap:FileType>
              <uap:FileType>.log</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!--
      privateNetworkClientServer: connections to the local network (home/work), which is where the
      PC receiver lives. internetClient is not needed: the app never talks to the internet.
    -->
    <Capability Name="privateNetworkClientServer" />
    <!-- removableStorage: USB drives on the Xbox, for copies too big for the app's own storage (Blu-ray). -->
    <uap:Capability Name="removableStorage" />
    <!--
      Both capabilities below come from the XBSX2 Package.appxmanifest (PR #11):
      - "optical": device capability for the optical drive;
      - 53f56308-b6bf-11d0-94f2-00a0c91efb8b: the CD-ROM device interface class GUID
        (GUID_DEVINTERFACE_CDROM), required for Windows.Devices.Custom to open the interface.
    -->
    <DeviceCapability Name="optical" />
    <DeviceCapability Name="53f56308-b6bf-11d0-94f2-00a0c91efb8b" />
  </Capabilities>
</Package>
