<Page
    x:Class="xISOBurn.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:xISOBurn"
    Background="#000000">

    <!-- Margins inside the TV "safe area" (the Xbox already reserves the edge; this is just breathing room). -->
    <Grid Padding="48,16,48,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner: the logo from designer.png (Assets\Banner.png, generated by tools\make-assets.ps1). -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="24">
            <Image Source="Assets/Banner.png" Height="110" Stretch="Uniform" HorizontalAlignment="Left"
                   AutomationProperties.Name="xISOBurn"/>
            <TextBlock Text="Milestone 2 — multi-pass, resumable rescue to a local file (LocalState)"
                       FontSize="18" Opacity="0.7" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Controller-only navigation: D-pad between buttons, A activates, B cancels a copy. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12">
            <Button x:Name="DetectButton" Content="Detect disc" Click="DetectButton_Click" FontSize="20" Padding="20,10"/>
            <Button x:Name="CopyButton" Content="Rescue / resume" Click="CopyButton_Click" FontSize="20" Padding="20,10"/>
            <Button x:Name="CancelButton" Content="Cancel (B)" Click="CancelButton_Click" FontSize="20" Padding="20,10" IsEnabled="False"/>
            <Button x:Name="SpikeButton" Content="Feasibility test" Click="SpikeButton_Click" FontSize="20" Padding="20,10"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#161616" BorderBrush="#2E7D32" BorderThickness="1" Padding="16,12" CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock Text="Disc" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="DiscText" Text="Press &quot;Detect disc&quot;." FontSize="16" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#161616" BorderBrush="#2E7D32" BorderThickness="1" Padding="16,12" CornerRadius="4">
                <StackPanel Spacing="6">
                    <TextBlock Text="Progress" FontSize="20" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="Bar" Minimum="0" Maximum="100" Value="0" Height="12" Foreground="#4CC417"/>
                    <TextBlock x:Name="ProgressText" Text="-" FontSize="16" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ConfigText" FontSize="13" Opacity="0.7" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log in a ListView: every line takes focus, so the D-pad scrolls the list. -->
        <ListView x:Name="LogList" Grid.Row="3" SelectionMode="None" IsItemClickEnabled="False"
                  BorderThickness="1" BorderBrush="#333333" Background="#0C0C0C">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="MinHeight" Value="0"/>
                    <Setter Property="Padding" Value="8,0"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:LogLine">
                    <TextBlock Text="{x:Bind Text}" FontFamily="Consolas" FontSize="14" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="16" TextWrapping="Wrap" Opacity="0.9"/>
    </Grid>
</Page>
